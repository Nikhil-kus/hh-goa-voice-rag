# ── Sarvam STT ────────────────────────────────────────────────────────────────
SARVAM_API_KEY=your_sarvam_key_here

# ── LLM (pick one provider and set its key) ───────────────────────────────────
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=your_groq_key_here
# OPENAI_API_KEY=
# TOGETHER_API_KEY=
# GEMINI_API_KEY=

# ── Qdrant ────────────────────────────────────────────────────────────────────
USE_QDRANT_LOCAL=true
QDRANT_LOCAL_PATH=./qdrant_data
# For Docker/Cloud mode:
# USE_QDRANT_LOCAL=false
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# QDRANT_API_KEY=

# ── Dataset / Ingestion ───────────────────────────────────────────────────────
LANGUAGES_TO_INDEX=hi,bn,ta,te,kn
RECORDS_PER_LANGUAGE=5000
CHUNKING_STRATEGIES=fixed_size_overlap,sentence_aware,passage_structure_aware

# ── RAG tuning ────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=10
EVIDENCE_THRESHOLD=0.25
GROUNDING_THRESHOLD=0.15
RERANKER_ENABLED=false

# ── Guardrails ────────────────────────────────────────────────────────────────
SUPPORTED_LANGUAGES=hi,bn,ta,te,kn
OFF_TOPIC_THRESHOLD=0.15
MAX_TRANSCRIPT_CHARS=500

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
